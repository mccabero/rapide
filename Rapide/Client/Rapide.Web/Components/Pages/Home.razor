@page "/"
@using Rapide.Web.Components.Pages.Components.Dashboard
@using Rapide.Web.Components.Utilities
@using Rapide.Web.Models

<PageTitle>Dashboard</PageTitle>

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Dashboard</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">

        @if (!isTechnician)
        {
            @* Dashboard Components *@
            <DashboardCardsComponent />
        }

        <div class="row">
            @* Inactive Customers *@
            <section class="col-lg-12 connectedSortable">

                <!-- TO DO List -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ion ion-clipboard mr-1"></i>
                            Inactive Customers (For the last 6 months)
                        </h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        @* Table here. *@
                        <div class="row">
                            <div class="col-md-12">
                                <MudDataGrid Dense T="JobOrderModel" @ref="dataGrid" ServerData="ServerReload" Filterable="false" RowsPerPage="10">
                                    <ToolBarContent>
                                        <MudRadioGroup T="string" Value="@clientType" ValueChanged="@(s => OnFilter(s))">
                                            <MudRadio Value="@Constants.ClientType.All" Color="Color.Success" Dense="true">@Constants.ClientType.All</MudRadio>
                                            <MudRadio Value="@Constants.ClientType.Rapide" Color="Color.Warning" Dense="true" sele>@Constants.ClientType.Rapide</MudRadio>
                                            <MudRadio Value="@Constants.ClientType.Changan" Color="Color.Info" Dense="true">@Constants.ClientType.Changan</MudRadio>
                                        </MudRadioGroup>
                                        <MudSpacer />
                                        <MudTextField T="string" ValueChanged="@(s => OnSearch(s))" Placeholder="Search" Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Class="mt-0"></MudTextField>
                                    </ToolBarContent>
                                    <Columns>
                                        @* <PropertyColumn Property="x => x.Id" Title="Id" /> *@
                                        <PropertyColumn Property="x => x.IsChangan" Title="Client Type" Sortable="false" Filterable="false">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudChip T="string"
                                                             Size="@Size.Medium"
                                                             Color="@(@context.Item.IsChangan ? Color.Info : Color.Warning)">
                                                        @(@context.Item.IsChangan? Constants.ClientType.Changan : Constants.ClientType.Rapide)
                                                    </MudChip>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.ReferenceNo" Title="Reference No.">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudLink Href="@string.Format("/operations/job-orders/{0}", @context.Item.Id.ToString())">@context.Item.ReferenceNo</MudLink>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.TransactionDate" Title="JO date">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudText>@(((DateTime)context.Item.TransactionDate!).ToShortDateString())</MudText>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.Customer" Title="Customer">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudLink Href="@string.Format("/customers/{0}", @context.Item.Customer.Id.ToString())">@($"{context.Item.Customer.FirstName} {@context.Item.Customer.LastName}")</MudLink>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.Vehicle" Title="Plate No.">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudLink Href="@string.Format("/vehicles/{0}", @context.Item.Vehicle.Id.ToString())">@context.Item.Vehicle.PlateNo</MudLink>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.Vehicle" Title="Vehicle Model">
                                            <CellTemplate>
                                                <MudText>@($"{context.Item.Vehicle.VehicleModel.VehicleMake.Name} {context.Item.Vehicle.VehicleModel.Name} ({context.Item.Vehicle.YearModel})")</MudText>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.IsPackage" Title="Job Order Type" Sortable="false" Filterable="false">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudChip T="string" Color="@(context.Item.IsPackage? Color.Tertiary: Color.Surface)">
                                                        @(context.Item.IsPackage ? "Package" : "Regular")
                                                    </MudChip>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <PropertyColumn Property="x => x.JobStatus.Name" Title="Status">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudChip T="string"
                                                             Color="context.Item.StatusChipColor">
                                                        @context.Item.JobStatus.Name
                                                    </MudChip>
                                                </MudStack>
                                            </CellTemplate>
                                        </PropertyColumn>
                                        <TemplateColumn Title="Action" Filterable="false" Sortable="false">
                                            <CellTemplate>
                                                <MudStack Row>
                                                    <MudButton Size="@Size.Medium" Variant="@Variant.Filled" Href="@string.Format("/operations/job-orders/{0}", @context.Item.Id.ToString())" Color="@Color.Primary"><i class="fa fa-pencil-square-o"></i></MudButton>
                                                </MudStack>
                                            </CellTemplate>
                                        </TemplateColumn>
                                    </Columns>
                                    <PagerContent>
                                        <MudDataGridPager T="JobOrderModel" />
                                    </PagerContent>
                                </MudDataGrid>
                            </div>
                        </div>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer clearfix">
                        @* <button type="button" class="btn btn-primary float-right"><i class="fas fa-plus"></i> Add item</button> *@
                    </div>
                </div>
                <!-- /.card -->
            </section>
        </div>

        <div class="row">
            
            @* Customers Birthday *@
            <section class="col-lg-6 connectedSortable">

                <!-- TO DO List -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ion ion-clipboard mr-1"></i>
                            Customers Birthday (Current Month)
                        </h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <ul class="todo-list" data-widget="todo-list">
                            @if (CustomerBirthdayMonthList.Any())
                            {
                                @foreach (var bm in CustomerBirthdayMonthList)
                                {
                                    <li>
                                        <!-- drag handle -->
                                        <span class="handle">
                                            <i class="fas fa-ellipsis-v"></i>
                                            <i class="fas fa-ellipsis-v"></i>
                                        </span>
                                        <!-- todo text -->
                                        <span class="text">@($"{bm.FirstName} {bm.LastName}")</span>
                                        <!-- Emphasis label -->
                                        <small class="badge badge-info"><i class="far fa-clock"></i> @(((DateTime)bm.Birthday.Value).ToString("MMMM dd"))</small>
                                        <div class="tools">
                                            <a href="@($"/customers/{bm.Id}")"><i class="fas fa-edit"></i></a>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <label>No birthday celebrant for this month.</label>
                            }
                        </ul>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer clearfix">
                        @* <button type="button" class="btn btn-primary float-right"><i class="fas fa-plus"></i> Add item</button> *@
                    </div>
                </div>
                <!-- /.card -->
            </section>
      
            @* Employees Birthday *@
            <section class="col-lg-6 connectedSortable">

                <!-- TO DO List -->
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="ion ion-clipboard mr-1"></i>
                            Employees Birthday (Current Month)
                        </h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <ul class="todo-list" data-widget="todo-list">
                            @if (EmployeeBirthdayMonthList.Any())
                            {
                                @foreach (var bm in EmployeeBirthdayMonthList)
                                {
                                    <li>
                                        <!-- drag handle -->
                                        <span class="handle">
                                            <i class="fas fa-ellipsis-v"></i>
                                            <i class="fas fa-ellipsis-v"></i>
                                        </span>
                                        <!-- todo text -->
                                        <span class="text">@($"{bm.FirstName} {bm.LastName}")</span>
                                        <!-- Emphasis label -->
                                        <small class="badge badge-info"><i class="far fa-clock"></i> @(((DateTime)bm.Birthday.Value).ToString("MMMM dd"))</small>
                                        <div class="tools">
                                            <a href="@($"/administrators/users/{bm.Id}")"><i class="fas fa-edit"></i></a>
                                        </div>
                                    </li>
                                }
                            }
                            else
                            {
                                <label>No birthday celebrant for this month.</label>
                            }

                        </ul>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer clearfix">
                        @* <button type="button" class="btn btn-primary float-right"><i class="fas fa-plus"></i> Add item</button> *@
                    </div>
                </div>
                <!-- /.card -->
            </section>
        </div>
    </div>
</section>
